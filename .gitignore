# 运行时与临时文件（Ollama 模型约 4.6GB，不入库）
/.runtime/
/tmp/
/output/

# 压缩包（内容已在目录中）
*.zip
*.rar

# 第三方论文 PDF（版权原因不上传）
/资料/**/*.pdf
/周五汇报材料/04_参考原文/*.pdf

# 第三方论文全文转录（版权原因不上传，保留自撰笔记）
/调研/[[]*.txt

# 空文件与聊天记录草稿
/新建 DOCX 文档.docx
/嗯*.docx

# Office 临时锁文件
~$*

# 账号数据库（其目录内已有 .gitignore 双保险）
*.sqlite
*.sqlite-shm
*.sqlite-wal
